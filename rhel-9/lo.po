#: ../meh/handler.py:195
msgid ""
"Use 'continue' command to quit the debugger and get back to the main menu"
msgstr ""
"ໃຊ້ຄຳສັ່ງ 'continue' ເພື່ອອອກຈາກຕົວແກ້ໄຂຈຸດບົກຜ່ອງ ແລະ ກັບຄືນສູ່ເມນູຫຼັກ"

#: ../meh/handler.py:211
msgid "Exit the shell to get back to the main menu"
msgstr "ອອກຈາກ shell ເພື່ອກັບຄືນສູ່ເມນູຫຼັກ"

#: ../meh/ui/gui.py:176
msgid "_Exit"
msgstr "_ອອກ"

#. short (one-char) answer meaning "yes"
#: ../meh/ui/text.py:75
msgid "y"
msgstr "ມ"

#. short (one-char) answer meaning "no"
#: ../meh/ui/text.py:78
msgid "n"
msgstr "ບ"

#: ../meh/ui/text.py:145
msgid "Save exception"
msgstr "ບັນທຶກຂໍ້ຜິດພາດ"

#: ../meh/ui/text.py:158 tmp/exception-dialog.glade.h:1
msgid "An unknown error has occurred"
msgstr "ເກີດຂໍ້ຜິດພາດທີ່ບໍ່ຮູ້ຈັກ"

#: ../meh/ui/text.py:161
msgid "Report Bug"
msgstr "ລາຍງານບັນຫາ"

#: ../meh/ui/text.py:162
msgid "Run shell"
msgstr "ແລ່ນ shell"

#: ../meh/ui/text.py:163
msgid "Quit"
msgstr "ອອກ"

#: ../meh/ui/text.py:168
msgid "Debug"
msgstr "ແກ້ໄຂຈຸດບົກຜ່ອງ"

#: ../meh/ui/text.py:173
msgid "What do you want to do now?"
msgstr "ທ່ານຕ້ອງການເຮັດຫຍັງຕອນນີ້?"

#: ../meh/ui/text.py:181
msgid "Please make your choice from above: "
msgstr "ກະລຸນາເລືອກຈາກທາງເທິງ: "

#: ../meh/ui/text.py:199
msgid "Hit ENTER to continue"
msgstr "ກົດ ENTER ເພື່ອດຳເນີນການຕໍ່"

#: ../meh/ui/text.py:213
#, python-format
msgid "Are you sure you want to exit? [%(yes)s/%(no)s]"
msgstr "ທ່ານແນ່ໃຈຫຼືບໍ່ວ່າຕ້ອງການອອກ? [%(yes)s/%(no)s]"

#: tmp/exception-dialog.glade.h:2
msgid ""
"This program has encountered an unknown error. You may\n"
"report the bug below or quit the program."
msgstr ""
"ໂປຣແກຣມນີ້ພົບຂໍ້ຜິດພາດທີ່ບໍ່ຮູ້ຈັກ. ທ່ານສາມາດ\n"
"ລາຍງານຂໍ້ຜິດພາດຢູ່ລຸ່ມນີ້ ຫຼື ອອກຈາກໂປຣແກຣມ."

#: tmp/exception-dialog.glade.h:4
msgid "_Report Bug"
msgstr "_ລາຍງານບັນຫາ"

#: tmp/exception-dialog.glade.h:5
msgid "_Quit"
msgstr "_ອອກ"

#: tmp/exception-dialog.glade.h:6
msgid "The output below may help determine the cause of the error:"
msgstr "ຜົນການເຮັດວຽກດ້ານລຸ່ມນີ້ອາດຊ່ວຍລະບຸສາເຫດຂອງຂໍ້ຜິດພາດໄດ້:"

#: tmp/exception-dialog.glade.h:7
msgid "'Debug' may take you to tty1."
msgstr "'ແກ້ໄຂຈຸດບົກຜ່ອງ' ອາດຈະພາທ່ານໄປທີ່ tty1."

#: tmp/exception-dialog.glade.h:8
msgid "_Debug"
msgstr "_ແກ້ໄຂຈຸດບົກຜ່ອງ"

#: tmp/exception-dialog.glade.h:9
msgid "More _info..."
msgstr "_ຂໍ້ມູນເພີ່ມເຕີມ..."

#: tmp/exception-dialog.glade.h:10
msgid "No additional info available."
msgstr "ບໍ່ມີຂໍ້ມູນເພີ່ມເຕີມ."
