#: ../meh/handler.py:202
msgid ""
"Use 'continue' command to quit the debugger and get back to the main menu"
msgstr ""
"Izmantojiet komandu „continue”, lai izietu no atkļūdotāja un atgrieztos "
"galvenajā izvēlnē"

#: ../meh/handler.py:218
msgid "Exit the shell to get back to the main menu"
msgstr "Izejiet no čaulas, lai atgrieztos galvenajā izvēlnē"

#: ../meh/ui/gui.py:39
msgid ""
"This program has encountered an unknown error. You may report the bug below "
"or quit the program."
msgstr ""
"Šajā programmā radās nezināma kļūda. Varat ziņot par kļūdu zemāk vai iziet "
"no programmas."

#: ../meh/ui/gui.py:43
msgid ""
"This program has encountered an unknown error.\n"
"You may want to consult the documentation for how to gather logs and report "
"a bug.\n"
"Or you can quit the program."
msgstr ""
"Šajā programmā radās nezināma kļūda.\n"
"Ieteicams iepazīties ar dokumentāciju par to, kā savākt žurnālus un ziņot "
"par kļūdu.\n"
"Vai arī varat iziet no programmas."

#: ../meh/ui/gui.py:205
msgid "_Exit"
msgstr "_Iziet"

#. short (one-char) answer meaning "yes"
#: ../meh/ui/text.py:82
msgid "y"
msgstr "j"

#. short (one-char) answer meaning "no"
#: ../meh/ui/text.py:85
msgid "n"
msgstr "n"

#: ../meh/ui/text.py:152
msgid "Save exception"
msgstr "Saglabāt izņēmumu"

#: ../meh/ui/text.py:165 tmp/exception-dialog.glade.h:1
msgid "An unknown error has occurred"
msgstr "Radās nezināma kļūda"

#: ../meh/ui/text.py:168
msgid "Run shell"
msgstr "Palaist čaulu"

#: ../meh/ui/text.py:169
msgid "Quit"
msgstr "Iziet"

#: ../meh/ui/text.py:174
msgid "Debug"
msgstr "Atkļūdot"

#: ../meh/ui/text.py:178
msgid "Report Bug"
msgstr "Ziņot par kļūdu"

#: ../meh/ui/text.py:183
msgid "What do you want to do now?"
msgstr "Ko vēlaties darīt tagad?"

#: ../meh/ui/text.py:191
msgid "Please make your choice from above: "
msgstr "Lūdzu, izvēlieties kādu no iepriekš minētajām iespējām: "

#: ../meh/ui/text.py:209
msgid "Hit ENTER to continue"
msgstr "Nospiediet ENTER, lai turpinātu"

#: ../meh/ui/text.py:223
#, python-format
msgid "Are you sure you want to exit? [%(yes)s/%(no)s]"
msgstr "Vai tiešām vēlaties iziet? [%(yes)s/%(no)s]"

#: tmp/exception-dialog.glade.h:2
msgid "_Report Bug"
msgstr "_Ziņot par kļūdu"

#: tmp/exception-dialog.glade.h:3
msgid "_Quit"
msgstr "_Iziet"

#: tmp/exception-dialog.glade.h:4
msgid "The output below may help determine the cause of the error:"
msgstr "Tālāk redzamā izvade var palīdzēt noteikt kļūdas cēloni:"

#: tmp/exception-dialog.glade.h:5
msgid "'Debug' may take you to tty1."
msgstr "„Atkļūdot” var jūs pārvest uz tty1."

#: tmp/exception-dialog.glade.h:6
msgid "_Debug"
msgstr "_Atkļūdot"

#: tmp/exception-dialog.glade.h:7
msgid "More _info..."
msgstr "_Vairāk informācijas..."

#: tmp/exception-dialog.glade.h:8
msgid "No additional info available."
msgstr "Papildu informācija nav pieejama."
